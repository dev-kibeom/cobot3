# ==========================================
# ROS 2 Workspace Directories (필수 제외)
# ==========================================
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
ros2_ws/**/test/

# colcon artifacts accidentally nested under ros2_ws/src
ros2_ws/src/build/
ros2_ws/src/install/
ros2_ws/src/log/
ros2_ws/src/vision/build/
ros2_ws/src/vision/install/
ros2_ws/src/vision/log/
ros2_ws/src/vision/vision/build/
ros2_ws/src/vision/vision/install/
ros2_ws/src/vision/vision/log/

# ==========================================
# 레거시 및 공용 라이브러리
# ==========================================
ros2_ws/src/doosan-robot2/


# ==========================================
# Data (이미지 및 데이터 파일)
# ==========================================
*.pt
*.usd

# vision: exclude large input datasets, but keep trained best.pt + run outputs
ros2_ws/src/vision/work/datasets/
!ros2_ws/src/vision/work/runs/**/weights/best.pt

# ==========================================
# Python (임시 및 캐시 파일)
# ==========================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/

# ==========================================
# C++ / Compiled Object Files
# ==========================================
*.o
*.so
*.a
*.dylib
*.dll

# ==========================================
# IDE / Editor Settings
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~

# ==========================================
# OS Specific
# ==========================================
.DS_Store
Thumbs.db