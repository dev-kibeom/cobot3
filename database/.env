# ==========================================
# 스마트 팩토리 FMS 중앙 서버 환경 설정
# ==========================================

# 1. FastAPI 서버 설정
SERVER_HOST=0.0.0.0
SERVER_PORT=8001

# 2. MQTT 브로커 설정
MQTT_BROKER_IP=127.0.0.1
MQTT_PORT=1883

# 3. 데이터베이스 설정 (현재 로컬 SQLite, 추후 Supabase 연결 시 여기를 변경)
DATABASE_URL=sqlite:///./smart_factory.db